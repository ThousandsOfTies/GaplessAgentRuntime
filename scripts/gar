#!/usr/bin/env python3
# PYTHON_ARGCOMPLETE_OK
from __future__ import annotations

import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]


# Launcherの処理概要:
# - gar.cmdまたはこのscriptは、system Pythonや別Projectのvenvで起動され得る。
# - repositoryの.venvが有効でなければ、共通bootstrapでPythonとruntime依存を
#   準備し、元のCLI引数を保ったまま、そのPythonでこのscriptを一度だけ再実行する。
# - 再実行した子processには再帰防止用のGAR_VENVを設定する。手動でrepositoryの
#   venvをactivate済みならVIRTUAL_ENVが一致するため、再実行せずCLI処理へ進む。
# - このlauncherは定義済みのGAR CLI引数だけをそのままCLI本体へ渡す。
def main() -> int:
    sys.path.insert(0, str(ROOT))
    from scripts.gar_lib.console import configure_output

    configure_output()
    from scripts.gar_lib.bootstrap import relaunch_in_venv

    relaunched = relaunch_in_venv(Path(__file__).resolve(), sys.argv[1:])
    if relaunched is not None:
        return relaunched

    from scripts.gar_lib.cli import main as cli_main

    return cli_main()


if __name__ == "__main__":
    raise SystemExit(main())
